plugins {
    id 'java'
    id 'com.gradleup.shadow' version '8.3.6'
}

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(25)
    }
}

tasks.withType(JavaCompile).configureEach {
    options.release = 8
    options.encoding = 'UTF-8'

    options.incremental = true
    options.fork = true
    options.forkOptions.jvmArgs << "-XX:+UseZGC" << "-XX:+ZGenerational"
}

project.ext.group = 'io.starflow.client'
project.ext.VERSION = "v1.0-SNAPSHOT"
project.ext.LastChangeTime = "20260201"
project.ext.lwjglVersion = "3.3.6"
project.ext.lwjglNatives = "natives-windows"
project.ext.mixinVersion = "0.8.7"

repositories {
    mavenCentral()
    maven { url = uri("${projectDir}/libs/mavens") }
    maven { url = uri("https://maven.aliyun.com/repository/gradle-plugin") }
    maven { url = uri("https://maven.lwjgl.org") }
    maven { url = uri("https://nexus.gtnewhorizons.com/#browse/browse:public") }
    maven { url = uri("https://oss.sonatype.org/service/local/repositories/releases/content/") }
    maven { url = uri("https://maven.aliyun.com/repository/public/") }
    maven { url = uri("https://libraries.minecraft.net/") }
    maven { url = uri("https://repo.marcloud.net/") }
    // maven { url = uri("https://repo.spongepowered.org/repository/maven-public/") } // SpongePoweredMixin
    // maven { url = uri('https://maven.cleanroommc.com') } // MixinBooter
}

dependencies {
    implementation fileTree(dir: "libs", includes: ["*.jar"])

    implementation "org.lwjgl:lwjgl:$lwjglVersion"
    implementation "org.lwjgl:lwjgl-glfw:$lwjglVersion"
    implementation "org.lwjgl:lwjgl-openal:$lwjglVersion"
    implementation "org.lwjgl:lwjgl-opengl:$lwjglVersion"
    implementation "org.lwjgl:lwjgl-nfd:$lwjglVersion"
    implementation "org.lwjgl:lwjgl-stb:$lwjglVersion"
    runtimeOnly "org.lwjgl:lwjgl:$lwjglVersion:$lwjglNatives"
    runtimeOnly "org.lwjgl:lwjgl-glfw:$lwjglVersion:$lwjglNatives"
    runtimeOnly "org.lwjgl:lwjgl-openal:$lwjglVersion:$lwjglNatives"
    runtimeOnly "org.lwjgl:lwjgl-opengl:$lwjglVersion:$lwjglNatives"
    runtimeOnly "org.lwjgl:lwjgl-nfd:$lwjglVersion:$lwjglNatives"
    runtimeOnly "org.lwjgl:lwjgl-stb:$lwjglVersion:$lwjglNatives"

    /*
    // === 原版 LWJGL 2 + Paulscode (保留参考) ===
    implementation "org.lwjgl.lwjgl:lwjgl:2.9.4-nightly-20150209"
    implementation "org.lwjgl.lwjgl:lwjgl_util:2.9.4-nightly-20150209"
    implementation "org.lwjgl.lwjgl:lwjgl-platform:2.9.4-nightly-20150209"
    implementation "com.paulscode:codecjorbis:20101023"
    implementation "com.paulscode:codecwav:20101023"
    implementation "com.paulscode:libraryjavasound:20101123"
    implementation "com.paulscode:librarylwjglopenal:20100824"
    implementation "com.paulscode:soundsystem:20120107"
    // implementation "com.mojang:netty:1.7.7" // 已被 io.netty 替代
     */

    /*
    // Mixin
    implementation("org.spongepowered:mixin:$mixinVersion") { transitive = false }
    annotationProcessor("org.spongepowered:mixin:$mixinVersion:processor")
    implementation("zone.rong:mixinbooter:10.7")
    annotationProcessor("zone.rong:mixinbooter:10.7")
    annotationProcessor 'com.google.guava:guava:32.1.3-jre'
    annotationProcessor 'com.google.code.gson:gson:2.10.1'
     */

    // 系统硬件信息
    implementation "com.github.oshi:oshi-core:4.4.2"

    // 本地访问
    implementation "net.java.dev.jna:jna:5.14.0"
    implementation "net.java.dev.jna:jna-platform:5.14.0"

    // 通用工具库
    implementation "com.google.guava:guava:32.1.3-jre"
    implementation "org.apache.commons:commons-lang3:3.18.0"
    implementation "commons-io:commons-io:2.16.1"
    implementation "commons-codec:commons-codec:1.17.1"
    implementation "org.apache.commons:commons-compress:1.26.0"
    implementation "org.joml:joml:1.10.5"

    // 网络通信
    implementation "io.netty:netty-all:4.0.23.Final"

    // JSON 和日志
    implementation "com.google.code.gson:gson:2.10.1"
    implementation "org.apache.logging.log4j:log4j-api:2.25.3"
    implementation "org.apache.logging.log4j:log4j-core:2.25.3"

    // HTTP 和输入设备
    implementation "org.apache.httpcomponents:httpclient:4.5.14"
    implementation "org.apache.httpcomponents:httpcore:4.4.16"
    implementation "net.java.jinput:jinput:2.0.5"
    implementation "net.java.jinput:jinput-platform:2.0.5"
    implementation "net.java.jutils:jutils:1.0.0"

    // Twitch 库
    implementation "tv.twitch:twitch:6.5"

    // Mojang 库
    implementation "com.mojang:icu4j-core-mojang:51.2"
    implementation "net.sf.jopt-simple:jopt-simple:5.0.4"
    implementation "com.mojang:authlib:1.5.21"
    implementation "com.mojang:patchy:1.7.7"
}

/*
tasks.withType(JavaCompile).configureEach {
    options.release = 8
    options.encoding = 'UTF-8'
    options.compilerArgs += [
        "-AoutRefMapFile=${project.buildDir}/resources/main/mixins.starflow.refmap.json",
        "-AreferencedMapFile=${project.projectDir}/src/main/resources/mixins.starflow.refmap.json",
        "-AdefaultObfuscationEnv=notch"
    ]
}
*/

shadowJar {
    archiveFileName = "StarFlow-${VERSION}-${LastChangeTime}.jar"
    mergeServiceFiles()
    manifest {
        attributes(
                'Main-Class': 'net.minecraft.client.main.Main',
                'MixinConfigs': 'mixins.starflow.json',
                'FMLCorePluginContainsFMLMod': 'true',
                'ForceLoadAsMod': 'true'
        )
    }
}

tasks.register('RunClient', JavaExec) {
    group = "application"
    description = "Run the Client"
    classpath = sourceSets.main.runtimeClasspath
    mainClass = "Start"
    workingDir = file("run")
    args = ['--username', 'Developer']

    javaLauncher = javaToolchains.launcherFor {
        languageVersion = JavaLanguageVersion.of(25)
    }
}